<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ (dataExtractionRules): exclude ALL app data from device-to-device transfer (D2D)
  and cloud backup. The profiles table holds plaintext source/dj passwords; even with
  allowBackup=false on older APIs, this makes the exclusion explicit and future-proof.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
